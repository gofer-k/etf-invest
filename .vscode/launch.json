{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Download ETF data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/data_downloader.py",
      "console": "integratedTerminal",
      "args": ["--tickers", "ISAC"]
    },
    {
      "name": "Import csv data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/import_data.py",
      "console": "integratedTerminal",
      "args": ["--input_file", "data/raw/IWMO.csv", "--ticket", "IWMO"]
    },
    {
      "name": "Backtesting",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "args": [
        "--ticker",
        "ISAC",
        "--period",
        "3m",
        "--interval",
        "1h",
        "--backtest",
        "true"
      ]
    },
    {
      "name": "Date converter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/convert_data_format.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/raw/ETFBW20LV_reformat.csv",
        "${workspaceFolder}/data/raw/ETFBW20LV_new.csv"
      ]
    },
    {
      "name": "Python Debugger: ETF script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "args": [
        "--ticker",
        "ISAC",
        "--period",
        "3m",
        "--interval",
        "1h",
        "--acd_signals",
        "true"
      ]
    },
    {
      "name": "Reverse CSV data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/reverse_csv.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/raw/REMX_new.csv",
        "${workspaceFolder}/data/processed/REMX.csv"
      ],
    },
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload"
      ],
      "jinja": true
    }
  ]
}