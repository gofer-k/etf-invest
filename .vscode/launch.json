{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Reverse CSV data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reverse_csv.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/raw/newREMX.csv",
        "${workspaceFolder}/data/processed/REMX.csv"
      ],
    },
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload"
      ],
      "jinja": true
    }
  ]
}